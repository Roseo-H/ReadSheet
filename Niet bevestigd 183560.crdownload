const CACHE = 'readsheet-v1';
const ASSETS = ['/', '/index.html', '/manifest.json'];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(CACHE).then(c => c.addAll(ASSETS)).then(() => self.skipWaiting()));
});

self.addEventListener('activate', e => {
  e.waitUntil(self.clients.claim());
});

self.addEventListener('fetch', e => {
  const url = new URL(e.request.url);
  if (e.request.method === 'POST' && url.pathname === '/share-target') {
    e.respondWith(handleShare(e.request));
    return;
  }
  e.respondWith(
    caches.match(e.request).then(r => r || fetch(e.request).catch(() => caches.match('/')))
  );
});

async function handleShare(request) {
  try {
    const formData = await request.formData();
    const files = formData.getAll('files');
    // Store temporarily in a simple way - open IDB and save
    // For simplicity we redirect and let the page handle via URL or message
    const clients = await self.clients.matchAll({ type: 'window' });
    if (clients.length) {
      clients[0].postMessage({ type: 'shared-files', count: files.length });
    }
    // Best effort: open the app
    return Response.redirect('/?shared=1', 303);
  } catch (err) {
    return Response.redirect('/?shared=error', 303);
  }
}